{
  "name": "opencode-openai-autocontinue",
  "version": "0.3.0",
  "description": "OpenCode plugin (2.x and 1.x): when a ChatGPT/Codex subscription usage limit stops a session, wait for the reset and continue it",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blauertee/opencode-openai-autocontinue.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "openai",
    "chatgpt",
    "codex",
    "rate-limit"
  ],
  "exports": {
    ".": "./src/server.ts",
    "./server": "./src/server.ts"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc -p . && tsc -p tsconfig.test.json",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.19.0 <2",
    "@opencode/plugin": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.19.5",
    "@opencode-ai/sdk": "1.19.5",
    "@opencode/plugin": "2.2.5",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
